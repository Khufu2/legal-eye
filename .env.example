# Browser-safe Supabase connection values from Dashboard -> Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local CLI and service configuration. Never commit real values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_STRING=
GEMINI_API_KEY=
GEMINI_MODEL_ROUTER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ROUTER=
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_VISION=

# Never prefix privileged server credentials with NEXT_PUBLIC_.
# Supabase automatically supplies its URL and server keys to hosted Edge Functions.


# Optional Railway open-corpus-worker source credential.
# Request from New Zealand Parliamentary Counsel Office and store on Railway, not in client code.
NZ_LEGISLATION_API_KEY=

# Locke billing secrets (server-side only). Enable checkout after configuring
# the production Snippe webhook and applying the billing migration.
LOCKE_SNIPPE_API_KEY=
LOCKE_SNIPPE_WEBHOOK_SECRET=
LOCKE_BILLING_SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_LOCKE_BILLING_VISIBLE=0
LOCKE_SNIPPE_ENABLED=0
LOCKE_BILLING_ENFORCED=0

# Optional AI Gateway model IDs. Blank inherits LEGAL_EYE_AI_MODEL.
LOCKE_RESEARCH_AI_MODEL=
LOCKE_AGENT_AI_MODEL=
LOCKE_DOCUMENT_AI_MODEL=

# Allow explicit exports to the user-selected Google Drive account.
NEXT_PUBLIC_LOCKE_GOOGLE_EXPORT_ENABLED=0
